/* ---------- Base ---------- */
QWidget { font-family: "IBM Plex Sans"; font-size: 13px; color: #1A1D23; }
QMainWindow, QDialog { background: #FFFFFF; }

/* ---------- Champs ---------- */
QLineEdit, QComboBox, QPlainTextEdit, QSpinBox, QAbstractSpinBox, QKeySequenceEdit {
  background: #F6F7F9; border: 1px solid #E7E9EE; border-radius: 8px;
  padding: 10px 13px; font-size: 14px; color: #1A1D23; selection-background-color: #EEF1FE;
}
QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus,
QKeySequenceEdit:focus { border-color: #3B5BDB; }
QPlainTextEdit#promptEditor {
  font-family: "IBM Plex Mono"; font-size: 12.5px; line-height: 1.6; color: #344054;
}

/* Liste des prompts (Préférences › Prompts, CHANGELOG_v2 §1) : cadre net */
QListWidget#promptsList { border: 1px solid #E7E9EE; border-radius: 8px; background: #fff; }
QListWidget#promptsList::item { border: none; }

/* Champ de recherche (barre d'action de capture) — pas de focus ring (correctif #6) */
QLineEdit#searchField:focus { border: 1px solid #E7E9EE; outline: none; }

/* Combobox (correctif #8) : chevron custom, pas les flèches système */
QComboBox { font-size: 13.5px; color: #1A1D23; }
QComboBox::drop-down { border: none; width: 28px; }
QComboBox::down-arrow { image: url(__CARET_UP_DOWN__); width: 14px; height: 14px; }

/* QSpinBox (correctif #10) : valeur mono, chevrons custom empilés */
QSpinBox { font-family: "IBM Plex Mono"; font-size: 13.5px; color: #1A1D23; padding: 8px 13px; }
QSpinBox::up-button, QSpinBox::down-button {
  border: none; background: transparent; width: 16px; subcontrol-origin: border;
}
QSpinBox::up-button { subcontrol-position: top right; }
QSpinBox::down-button { subcontrol-position: bottom right; }
QSpinBox::up-arrow { image: url(__CARET_UP__); width: 10px; height: 10px; }
QSpinBox::down-arrow { image: url(__CARET_DOWN__); width: 10px; height: 10px; }

/* ---------- Boutons ---------- */
QPushButton { font-size: 13.5px; font-weight: 600; border-radius: 9px; padding: 10px 18px; }
QPushButton#primary   { background: #3B5BDB; color: #fff; border: none; }
QPushButton#primary:hover { background: #2A46B8; }
QPushButton#secondary { background: #fff; color: #344054; border: 1px solid #D6D9DE; }
QPushButton#secondary:hover { border-color: #3B5BDB; color: #2A46B8; }
QPushButton#danger    { background: #FF3B30; color: #fff; border: none; padding: 10px 20px; }
QPushButton#danger:hover { background: #E0342A; }
QPushButton#destructive { background: #fff; color: #B42318; border: 1px solid #F4C9C7; }
QPushButton#destructive:hover { background: #FEF3F2; }

/* ---------- Toolbar : icônes nues, jamais de cadre natif (correctif #2) ---------- */
QToolButton { border: none; background: transparent; }

/* Fond + filet du bas portés par le sélecteur d'objet (pas de setStyleSheet local
   sur le QWidget de la toolbar) : une feuille de style locale sur un ancêtre casse
   la résolution des pseudo-états (:checked) des enfants navTab/gearBtn ci-dessous
   sous le style natif macOS — repro isolée avant ce correctif. */
QWidget#toolbar { background: #FFFFFF; border-bottom: 1px solid #E7E9EE; }

/* ---------- Onglets de navigation (toolbar) ---------- */
QToolButton#navTab { background: transparent; border: none; border-bottom: 2px solid transparent;
  padding: 0 8px; font-size: 14px; font-weight: 600; color: #7A828F; }
QToolButton#navTab:checked { color: #2A46B8; border-bottom-color: #3B5BDB; }

/* ---------- Bouton engrenage Préférences (toolbar) ---------- */
QToolButton#gearBtn { background: transparent; border: none; border-radius: 8px; padding: 0; }
QToolButton#gearBtn:checked { background: #EEF1FE; }

/* ---------- Badge « Mise à jour disponible » (toolbar, docs/53) ---------- */
QToolButton#majBadge { background: #EEF1FE; color: #2A46B8; border: 1px solid #C9D2F6;
  border-radius: 9px; padding: 2px 8px 2px 6px; font-size: 11.5px; font-weight: 600; }
QToolButton#majBadge:hover { border-color: #3B5BDB; background: #E3E8FC; }
QToolButton#majBadge:disabled { color: #7A828F; border-color: #E7E9EE; background: #F5F6F8; }

/* ---------- Tableau : en-tête + lignes (correctifs #3 et #4) ---------- */
QHeaderView::section { background: #FBFBFC; color: #98A2B3; font-family: "IBM Plex Mono";
  font-size: 10px; text-transform: uppercase; border: none; border-bottom: 1px solid #EFF1F4;
  padding: 9px 0; }
QHeaderView::section:first { padding-left: 20px; }
QHeaderView::section:last { padding-right: 20px; }
QTableView { background: #fff; border: none; gridline-color: transparent;
  selection-background-color: #EEF1FE; selection-color: #1A1D23; }
QTableView::item { border: none; border-bottom: 1px solid #F1F2F5; }
/* Pas de rectangle de focus sur l'index courant des vues (cadre parasite sous
   Windows) — doublon de `StyleSansCadreFocus`, pour les vues que la feuille de
   style peint elle-même sans repasser par le style de l'application. */
QAbstractItemView { outline: 0; }

/* Éditeur de cellule (delegate = QLineEdit enfant de la vue, aucun objectName
   possible) : sans cette règle il hérite du style des champs plus haut
   (padding 10px, police 14px → sizeHint 42px) écrasé dans une ligne de 30px,
   donc le texte en cours de saisie sortait de la zone visible — invisible à
   l'écriture (retour terrain 2026-08-10, section Lexique). Police alignée sur
   celle du texte affiché (13px), pas sur celle des champs de formulaire. */
QAbstractItemView QLineEdit {
  padding: 0 4px; font-size: 13px; border-radius: 5px; min-height: 0;
  background: #fff; border: 1px solid #3B5BDB;
}

/* ---------- Sous-nav des préférences ---------- */
QListWidget#prefNav { background: #FBFBFC; border: none; border-right: 1px solid #EFF1F4; }
QListWidget#prefNav::item { padding: 8px 11px; border-radius: 8px; margin: 1px 8px;
  color: #667085; font-size: 13.5px; font-weight: 600; }
QListWidget#prefNav::item:selected { background: #EEF1FE; color: #2A46B8; }

/* ---------- Cases à cocher ---------- */
QCheckBox { font-size: 13.5px; spacing: 10px; }
QCheckBox::indicator { width: 19px; height: 19px; border-radius: 5px;
  border: 1.5px solid #CDD2DA; background: #fff; }
QCheckBox::indicator:checked { background: #3B5BDB; border-color: #3B5BDB;
  image: url(__CHECK_WHITE__); }

/* ---------- Menu du tray (§8.8 debriefMeet-C) : exception à la police maison —
   convention système macOS, pas IBM Plex. ".AppleSystemUIFont" est le nom de
   famille que Qt résout réellement vers SF Pro sur macOS (vérifié via
   QFontInfo.exactMatch) ; Segoe UI/sans-serif en repli Windows/Linux.
   Fond « vibrancy » quasi blanc (CHANGELOG_v2 §correctif 11 : la 1re passe
   était trop grise/foncée par rapport aux menus système) en best-effort :
   QSS n'a pas d'équivalent à `backdrop-filter: blur(40px) saturate(150%)`,
   donc pas de flou réel derrière le menu, seule la translucidité est
   reproduite. Bordure demandée à .5px : QSS n'accepte que des largeurs
   entières, arrondie à 1px. ---------- */
QMenu#trayMenu { background: rgba(247,248,250,.93); border: 1px solid rgba(0,0,0,.09);
  border-radius: 9px; padding: 4px; }
QMenu#trayMenu::item { font-family: ".AppleSystemUIFont", "Segoe UI", sans-serif;
  padding: 5px 9px; border-radius: 5px; font-size: 13px; font-weight: 400;
  color: #1D1D1F; icon-size: 14px 14px; }
QMenu#trayMenu::item:selected { background: #0A6CFF; color: #fff; }
QMenu#trayMenu::item:disabled { color: rgba(29,29,31,.35); }
QMenu#trayMenu::separator { height: 1px; background: rgba(0,0,0,.08); margin: 4px 0; }
QMenu#trayMenu::item:default { background: transparent; color: #1D1D1F; font-weight: 600; }
QMenu#trayMenu::item:default:selected { background: #0A6CFF; color: #fff; }

/* Ligne « Quitter » : `QMenu::item` en QSS ne peut pas cibler un item précis
   pour lui donner une couleur de texte statique (rouge) hors survol — rendu
   via un `QWidgetAction` custom (tray.py) plutôt qu'un `QAction` standard.
   Fond et couleur du libellé pilotés entièrement en Python (`_LigneQuitter`),
   pas ici : le pseudo-état `:hover` d'un `QWidget` composite (enfants dans un
   layout) ne se réévalue pas de façon fiable pour ses propres propriétés ni
   celles de ses enfants sous Qt (repro isolée avant ce choix — cf. §8.8). */
QWidget#trayQuitRow { border-radius: 5px; }
QLabel#trayQuitLabel { font-family: ".AppleSystemUIFont", "Segoe UI", sans-serif;
  font-size: 13px; font-weight: 400; }

/* ---------- Barre auto-save (préférences) ---------- */
QLabel#autosaveBar { background: #FBFBFC; border-top: 1px solid #E7E9EE;
  color: #667085; font-size: 12.5px; padding: 10px 20px; }

/* ---------- Popover d'actions (colonne « actions », §8.6.3) ----------
   Les items sont des QWidgetAction custom (cf. actions_menu.py) — ce QSS ne
   porte que le cadre du menu, pas les items (survol/couleur gérés en Python,
   même limite que QMenu#trayMenu pour une couleur de texte statique). */
QMenu#actionsMenu { background: #FFFFFF; border: 1px solid #E7E9EE;
  border-radius: 10px; padding: 5px; }
QMenu#actionsMenu::separator { height: 1px; background: #F0F1F4; margin: 5px 8px; }
