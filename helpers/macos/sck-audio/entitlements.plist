<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Accès micro — déclenche NSAudioCaptureUsageDescription (PAS Enregistrement de l'écran) -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Nécessaire pour la signature ad-hoc avec les entitlements d'audio -->
